# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real secrets.

# Database
# Matches docker-compose.yml's postgres service (POSTGRES_USER/PASSWORD/DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analytics_saas
# Matches docker-compose.yml's redis service; defaults to this if unset
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth & Security
# Must be a random string, 32+ characters
AUTH_SECRET=
# Must be a random string, 64+ characters
TOKEN_ENCRYPTION_KEY=
# Secret used to authorize cron-triggered endpoints, 32+ characters
CRON_SECRET=

# Messaging
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# AI
ANTHROPIC_API_KEY=
# Optional; defaults to "" if unset
Z_AI_API_KEY=

# Google Maps / Competitor Pricing
# Google Maps Places API (New) key. Self-service, key-based, no GBP approval
# needed. Powers public review/rating data via lib/clients/places.ts. Optional; defaults to "".
GOOGLE_MAPS_API_KEY=
# Gates Layer 2 competitor price extraction (fetch + LLM scrape of rival
# sites). Off by default - discovery/rating/priceLevel work without it.
COMPETITOR_PRICES_ENABLED=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Starter monthly price ID (kept for back-compat)
STRIPE_PRICE_ID=
# Pro plan price ID; optional, defaults to ""
STRIPE_PRICE_PRO=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
